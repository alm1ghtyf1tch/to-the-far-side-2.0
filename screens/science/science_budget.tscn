[node name="Intro" type="Label" parent="Center/Monitor/Screen/App/Body/Page/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.129, 0.129, 0.129, 1)
theme_override_fonts/font = ExtResource("2_body")
theme_override_font_sizes/font_size = 19
text = "A mission is not calculated once. The Flight Dynamics team will work out the flight four times, each time with better data. The funding level you choose now stays for the whole mission: every round is done at this level, and you will not be asked again. Money you do not reserve here moves on to the rocket, the spacecraft and the crew."
autowrap_mode = 3

